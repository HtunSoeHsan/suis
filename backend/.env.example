# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://suis:suispassword@localhost:5432/suis_db

# ─── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Face Recognition Thresholds ──────────────────────────────────────────────
# Cosine distance threshold (lower = more strict). Typical: 0.4–0.5
SIMILARITY_THRESHOLD=0.45
# MiniFASNet liveness score 0-1 (higher = more strict)
LIVENESS_THRESHOLD=0.6

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
