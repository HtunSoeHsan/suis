# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://suis:suispassword@postgres:5432/suis_db

# ─── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── CORS — set to your actual frontend domain ─────────────────────────────────
CORS_ORIGINS=https://your-frontend-domain.com

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Use a strong random string: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secure_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Face Recognition Thresholds ──────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.45
LIVENESS_THRESHOLD=0.6

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated Telegram usernames WITHOUT @ (e.g. john_admin,teacher_mary)
TELEGRAM_ALLOWED_USERNAMES=your_telegram_username
# "polling" for local dev | "webhook" for VPS production
BOT_MODE=polling
# Only required for webhook mode (VPS) — must be HTTPS domain
WEBHOOK_BASE_URL=https://your-domain.com
# Random secret: openssl rand -hex 20
WEBHOOK_SECRET_TOKEN=your_webhook_secret_here
